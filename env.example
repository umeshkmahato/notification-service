# Server configuration
PORT=5000

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE=notifications

# Email configuration (for email notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-password

# SMS configuration (for SMS notifications)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Push notification configuration (Firebase Cloud Messaging)
FCM_SERVER_KEY=your-fcm-server-key
FCM_API_URL=https://fcm.googleapis.com/fcm/send
FCM_APP_NAME=notification-service
FCM_PROJECT_ID=your-project-id
FCM_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
# Or set this instead of the individual env vars:
# FCM_SERVICE_ACCOUNT={"type":"service_account",...}
# FCM_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
